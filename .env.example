# Supabase Configuration (Optional)
# FITSYNC works out-of-the-box in local-first browser mode without these keys.
# To enable cloud persistence and Row Level Security (RLS), create a Supabase project,
# run the SQL in src/lib/supabase/schema.sql, and populate these values in .env.local:

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
